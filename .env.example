# Copy this file to .env for local development. Never commit .env.
COMPOSE_PROJECT_NAME=shopmate
APP_ENV=demo
LOG_LEVEL=INFO

API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

POSTGRES_DB=shopmate
POSTGRES_USER=shopmate
POSTGRES_PASSWORD=replace-with-local-postgres-password

REDIS_PASSWORD=replace-with-local-redis-password

MINIO_ROOT_USER=shopmate
MINIO_ROOT_PASSWORD=replace-with-local-minio-password

DATABASE_URL=postgresql+asyncpg://shopmate:replace-with-local-postgres-password@localhost:5432/shopmate
REDIS_URL=redis://:replace-with-local-redis-password@localhost:6379/0
MILVUS_HEALTH_URL=http://localhost:9091/healthz
READINESS_TIMEOUT_SECONDS=2.0

API_CORS_ORIGINS=http://localhost:3000
SSE_KEEPALIVE_SECONDS=15
SSE_TOTAL_TIMEOUT_SECONDS=120

# ---- Embeddings (stage 7) -------------------------------------------------
# Dense (1024-d) and sparse vectors both come from one local BGE-M3 forward pass.
# Weights are mounted at ./models/bge-m3 and never baked into the image.
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_PATH=./models/bge-m3
EMBEDDING_MODEL_REVISION=
EMBEDDING_CACHE_DIR=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_LENGTH=512
EMBEDDING_DIMENSION=1024

# ---- Hybrid retrieval -----------------------------------------------------
RETRIEVAL_DENSE_LIMIT=30
RETRIEVAL_SPARSE_LIMIT=30
RETRIEVAL_RRF_K=60
RETRIEVAL_CANDIDATE_LIMIT=30
RETRIEVAL_MIN_CHUNKS=4
RETRIEVAL_MAX_CHUNKS=8
RETRIEVAL_CONTEXT_TOKEN_BUDGET=2400
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=3
POLICY_MIN_EVIDENCE_SIMILARITY=0.42
RERANKER_ENABLED=false

# ---- Answer model (optional) ---------------------------------------------
# Leave empty to keep policy QA in "retrieval only" mode; it will refuse to answer.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.1
