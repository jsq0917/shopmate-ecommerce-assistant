# 前端环境变量示例。复制为 .env.local 使用；不要提交 .env.local。
#
# API 基础路径。默认 `/api/v1`：开发时由 vite dev server 代理到后端，
# 生产时由 web/nginx.conf 反代。仅当需要直连同源后端时才改为完整地址。
VITE_API_BASE_URL=/api/v1

# vite dev server 端口（默认 5173）。API_CORS_ORIGINS 需要包含该来源时才重要。
VITE_DEV_PORT=5173

# 开发代理目标：阶段 10 API 的地址（本地 uvicorn 或容器映射端口）。
VITE_API_PROXY_TARGET=http://localhost:8000

# 预览服务端口（vite preview）。
VITE_PREVIEW_PORT=4173

# ---- Playwright 端到端（e2e） --------------------------------------------
# 被测前端地址；默认与 dev server 一致。
PLAYWRIGHT_BASE_URL=http://localhost:5173
# 订单/退货流程使用的演示买家账号（本地开发库 fixture，合成数据）。
E2E_SHOPPER_EMAIL=e2e.shopper@example.invalid
E2E_SHOPPER_PASSWORD=shopmate-e2e-demo
