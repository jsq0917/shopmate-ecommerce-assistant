# ShopMate 生产环境变量模板（阶段 14）
#
#   cp .env.prod.example .env.prod
#   生成强随机值后填入；.env.prod 已在 .gitignore 中，禁止提交。
#
# 生成口令（PowerShell）：
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 40 | % {[char]$_})
# 生成口令（bash / Git Bash）：
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40; echo
#
# 本文件所有值都是占位符，不能直接用于生产。

# ---- 编排与镜像 -----------------------------------------------------------
# 生产栈使用独立项目名和独立数据卷，避免与本地开发栈（shopmate）互相污染。
COMPOSE_PROJECT_NAME=shopmate-prod

# 必须指向不可变 tag 或 digest 的内部仓库地址；禁止 :latest。
API_IMAGE=registry.example.invalid/shopmate/api:0.1.0
WEB_IMAGE=registry.example.invalid/shopmate/web:0.1.0

# 唯一对外端口（前面放终结 TLS 的边缘代理）。
WEB_PORT=8080

# BGE-M3 权重目录（只读挂载，约 2.3GB，永不进镜像）。
MODEL_DIR=./models

# ---- 数据服务口令（必须替换）---------------------------------------------
POSTGRES_DB=shopmate
POSTGRES_USER=shopmate
POSTGRES_PASSWORD=replace-with-a-40-char-random-password
REDIS_PASSWORD=replace-with-a-40-char-random-password
MINIO_ROOT_USER=shopmate
MINIO_ROOT_PASSWORD=replace-with-a-40-char-random-password

# ---- 应用安全（必须替换）--------------------------------------------------
# 令牌签名密钥；更换后已签发的 access/refresh token 与退货资格令牌全部失效。
JWT_SECRET=replace-with-a-40-char-random-secret
TOOL_TOKEN_SECRET=replace-with-a-40-char-random-secret

# 浏览器实际访问的公开来源，必须与边缘代理域名完全一致（含 https:// 与端口）。
# 多个来源用逗号分隔；禁止写 *（凭证模式下的通配符既无效也不安全）。
API_CORS_ORIGINS=https://shopmate.example.invalid

# 允许的 Host 头（逗号分隔）。留空则不启用 Host 校验；生产必须填写公网域名。
# !!! 必须包含 127.0.0.1 与 localhost：容器内健康检查（compose.prod.yaml 的 api healthcheck）
# !!! 和 docs/08 §4.6 的验证命令都直接请求 http://127.0.0.1:8000/health，Host 头即 127.0.0.1。
# 漏掉回环地址会让 api 永久 unhealthy，进而 web 因 depends_on: service_healthy 起不来。
TRUSTED_HOSTS=127.0.0.1,localhost,shopmate.example.invalid

# ---- 运行时 ---------------------------------------------------------------
LOG_LEVEL=INFO
READINESS_TIMEOUT_SECONDS=2.0
# uvicorn --forwarded-allow-ips：只信任这些来源发来的 X-Forwarded-* 头。
# 默认覆盖 Docker bridge（172.16.0.0/12）、私有网段与回环；禁止写 *（可被直连来源伪造来源 IP）。
FORWARDED_ALLOW_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20
SSE_KEEPALIVE_SECONDS=15
SSE_TOTAL_TIMEOUT_SECONDS=120

# 资源上限（按机器规格调整；BGE-M3 CPU 推理内存占用较大）。
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=6g

# ---- 向量化与检索 ---------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_LENGTH=512
EMBEDDING_DIMENSION=1024
RETRIEVAL_RRF_K=60
POLICY_MIN_EVIDENCE_SIMILARITY=0.42

# ---- 回答模型（可选）-----------------------------------------------------
# 留空则政策问答只返回引用并明确拒答，不会编造答案。
# 若填写，密钥只放在 .env.prod 或外部 secret 管理器，禁止写进镜像或仓库。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
