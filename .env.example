# Copy this file to .env for local development. Never commit .env.
COMPOSE_PROJECT_NAME=shopmate
APP_ENV=demo
LOG_LEVEL=INFO

API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

POSTGRES_DB=shopmate
POSTGRES_USER=shopmate
POSTGRES_PASSWORD=replace-with-local-postgres-password

REDIS_PASSWORD=replace-with-local-redis-password

MINIO_ROOT_USER=shopmate
MINIO_ROOT_PASSWORD=replace-with-local-minio-password

DATABASE_URL=postgresql+asyncpg://shopmate:replace-with-local-postgres-password@localhost:5432/shopmate
REDIS_URL=redis://:replace-with-local-redis-password@localhost:6379/0
MILVUS_HEALTH_URL=http://localhost:9091/healthz
READINESS_TIMEOUT_SECONDS=2.0

API_CORS_ORIGINS=http://localhost:3000
SSE_KEEPALIVE_SECONDS=15
SSE_TOTAL_TIMEOUT_SECONDS=120

# ---- Embeddings (stage 7) -------------------------------------------------
# Dense (1024-d) and sparse vectors both come from one local BGE-M3 forward pass.
# Weights are mounted at ./models/bge-m3 and never baked into the image.
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_PATH=./models/bge-m3
EMBEDDING_MODEL_REVISION=
EMBEDDING_CACHE_DIR=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_LENGTH=512
EMBEDDING_DIMENSION=1024

# ---- Hybrid retrieval -----------------------------------------------------
RETRIEVAL_DENSE_LIMIT=30
RETRIEVAL_SPARSE_LIMIT=30
RETRIEVAL_RRF_K=60
RETRIEVAL_CANDIDATE_LIMIT=30
RETRIEVAL_MIN_CHUNKS=4
RETRIEVAL_MAX_CHUNKS=8
RETRIEVAL_CONTEXT_TOKEN_BUDGET=2400
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=3
# Evidence gate calibrated on the 140-case gold set (dev split): 0.62.
# Keep compose / .env / docs in sync; a looser 0.42 is only a demo shortcut (see README §7).
POLICY_MIN_EVIDENCE_SIMILARITY=0.62
RERANKER_ENABLED=false

# ---- Answer model: DeepSeek (OpenAI-compatible endpoint) -------------------
# Baseline for production, development AND evaluation: deepseek-flash
# (= DeepSeek-V4.1-Flash; the gateway also accepts the alias deepseek-v4-flash).
# No key is committed here: fill LLM_API_KEY, or leave it empty to run
# "retrieval only" mode (the API then returns citations and refuses to answer).
LLM_PROFILE=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
# 0 = keep the provider default (the parameter is not sent).
LLM_MAX_TOKENS=0
# Safety ceiling for the chat page's per-conversation "max output tokens" override:
# the write path rejects anything above it, the read path clamps stale rows to it.
LLM_MAX_TOKENS_CAP=4096
# Course brief asks for qwen-max; to align temporarily set LLM_PROFILE=qwen and
# fill the DashScope key (base_url/model are filled from the profile, no other change):
# LLM_PROFILE=qwen   # base_url=https://dashscope.aliyuncs.com/compatible-mode/v1, model=qwen-max
